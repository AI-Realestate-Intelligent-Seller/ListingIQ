# Public base URL for the ListingIQ FastAPI service.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Email is sent by the FastAPI service (app/core/email.py) over SMTP.
# Configure SMTP_* and FRONTEND_URL in the backend .env — not here.

# Show the SMS workspace as its own dashboard tab. Set to false to hide it —
# conversations are then read in Follow-ups, which is where a lead lands on its
# first reply. Hiding is presentational only; the SMS API is unaffected.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
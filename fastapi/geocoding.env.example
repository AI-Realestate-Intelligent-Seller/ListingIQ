# Backend-only Lead Pool geocoding configuration.
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ListingIQ/1.0 (lead-geocoding)
GEOCODING_COUNTRY=us

# Public Nominatim requests are processed serially. Keep this at 1 second or
# slower unless NOMINATIM_BASE_URL points at a service with a different policy.
GEOCODING_REQUEST_INTERVAL_SECONDS=1.1
GEOCODING_TIMEOUT_SECONDS=12
GEOCODING_MAX_RETRIES=3

# ListingIQ FastAPI environment
# Keep credentials server-side. Never commit a populated .env file.
# Copy this file to .env and replace placeholders for the target environment.

# -----------------------------------------------------------------------------
# BatchData
# -----------------------------------------------------------------------------
# Backend-only credentials; never expose these through NEXT_PUBLIC_*.
# Sandbox: set BATCHDATA_API_MODE=sandbox and use a provider sandbox token.
# Sandbox runs are zero-cost and stay separate from live brokerage Lead Pools.
# Production: set BATCHDATA_API_MODE=live and use the production token.
# Use a 32+ character webhook secret and configure the same value at BatchData.
BATCHDATA_API_URL=https://api.batchdata.com
BATCHDATA_API_TOKEN=
BATCHDATA_API_MODE=live
BATCHDATA_WEBHOOK_SECRET=
BATCHDATA_STORAGE_ROOT=storage/integrations/batchdata

# -----------------------------------------------------------------------------
# DealMachine
# -----------------------------------------------------------------------------
# Backend-only credentials. Provider work is manually triggered.
# DEALMACHINE_ENCRYPTION_KEY is required when keys are saved or rotated
# through the internal API.
DEALMACHINE_API_KEY=
DEALMACHINE_BASE_URL=https://api.v2.dealmachine.com/v1
DEALMACHINE_ENCRYPTION_KEY=
DEALMACHINE_STORAGE_ROOT=storage/integrations/dealmachine

# -----------------------------------------------------------------------------
# PropertyRadar
# -----------------------------------------------------------------------------
# Backend-only credentials; never expose these through NEXT_PUBLIC_*.
# The public webhook URL is optional locally and required for external delivery.
# Use the complete HTTPS route ending in /api/v1/webhooks/propertyradar.
# Use a 32+ character webhook secret configured identically at PropertyRadar.
PROPERTYRADAR_API_TOKEN=
PROPERTYRADAR_API_BASE_URL=https://api.propertyradar.com
PROPERTYRADAR_PUBLIC_WEBHOOK_URL=
PROPERTYRADAR_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Geocoding
# -----------------------------------------------------------------------------
# Backend-only Lead Pool geocoding configuration.
# Public Nominatim requests are serialized; keep the interval at one second
# or slower unless the configured service has a different usage policy.
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ListingIQ/1.0 (lead-geocoding)
GEOCODING_COUNTRY=us
GEOCODING_REQUEST_INTERVAL_SECONDS=1.1
GEOCODING_TIMEOUT_SECONDS=12
GEOCODING_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Postgres / database
# -----------------------------------------------------------------------------
# Development: leave POSTGRES_URL commented to use the configured local
# SQLite fallback, or set an explicit sqlite:/// URL.
# Production: set a PostgreSQL SQLAlchemy URL and do not commit credentials.
POSTGRES_URL=postgresql+psycopg2://listingiq:password@localhost:5432/listingiq_db

# -----------------------------------------------------------------------------
# AWS credentials
# -----------------------------------------------------------------------------
# Server-side AWS credentials. Prefer an instance/task role in production
# when the deployment platform supports it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# S3 storage
# -----------------------------------------------------------------------------
# Bucket and region used by backend object-storage workflows.
S3_BUCKET=
S3_REGION=

# -----------------------------------------------------------------------------
# RAG / knowledge retrieval
# -----------------------------------------------------------------------------
# Relative paths resolve from the FastAPI directory.
# Leave BOBBIE_RAG_URL blank to use retrieval inside this application.
CHROMA_PATH=data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
KNOWLEDGE_COLLECTION=bobbie_knowledge
KNOWLEDGE_CHUNK_CHARS=900
KNOWLEDGE_CHUNK_OVERLAP=150
BOBBIE_RAG_URL=
# BOBBIE_KNOWLEDGE_PDF=data/knowledge/Bobbie_Fisher_REMAX_Comprehensive_Profile_and_AI_Knowledge_Base.pdf

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
# Use a local SMTP service such as Mailpit during development.
# Use provider credentials in production. Enable SMTP_SSL only for implicit
# TLS endpoints, commonly port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ListingIQ <no-reply@example.com>
SMTP_SSL=false

# -----------------------------------------------------------------------------
# Calendar
# -----------------------------------------------------------------------------
# Leave CALENDAR_API_URL blank to use the calendar inside this application.
# BOBBIE_TIMEZONE controls scheduling interpretation for conversations.
CALENDAR_DAYS=14
CALENDAR_SLOT_MINUTES=30
CALENDAR_API_URL=
BOBBIE_TIMEZONE=America/Chicago

# -----------------------------------------------------------------------------
# DeepSeek / conversational AI
# -----------------------------------------------------------------------------
# Keep the API key server-side and never commit it.
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_REQUEST_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Frontend connection
# -----------------------------------------------------------------------------
# Public base URL of the Next.js frontend, used for invitation and other
# application links.
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Redis / lead queue
# -----------------------------------------------------------------------------
# Redis connection and background lead-processing timing.
# LEAD_JOB_TIMEOUT_MS=0 disables the job timeout.
REDIS_URL=redis://127.0.0.1:6379/0
LEAD_QUEUE_COOLDOWN_MS=5000
LEAD_JOB_TIMEOUT_MS=0

# -----------------------------------------------------------------------------
# Telnyx / SMS
# -----------------------------------------------------------------------------
# Use SMS_MODE=simulation for local-only sending and SMS_MODE=telnyx for live
# sending with a number owned by the configured Telnyx account.
# TELNYX_PUBLIC_KEY verifies public inbound webhooks.
# Leave SIMULATION_SMS_URL blank to simulate inside this application.
SMS_MODE=simulation
TELNYX_FROM_NUMBER=+12245798015
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
SIMULATION_SMS_URL=

# -----------------------------------------------------------------------------
# Application security
# -----------------------------------------------------------------------------
# Use strong, unique secrets in every deployed environment.
# Never commit populated secret values.
SECRET_KEY=replace-with-a-secure-random-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
FERNET_KEY=replace-with-32-byte-base64-key

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# OAuth credentials and the backend callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -----------------------------------------------------------------------------
# Lead uploads
# -----------------------------------------------------------------------------
# Uploads stream to disk. These settings bound disk usage, parse time, and
# how long a preview waits for confirmation.
LEAD_UPLOAD_MAX_MB=50
LEAD_UPLOAD_DIR=data/uploads
LEAD_UPLOAD_TTL_MINUTES=30

# Backend-only secrets. Never prefix these with NEXT_PUBLIC_.
PROPERTYRADAR_API_TOKEN=
PROPERTYRADAR_API_BASE_URL=https://api.propertyradar.com
# Optional for localhost; required to register external webhook delivery.
PROPERTYRADAR_PUBLIC_WEBHOOK_URL=
# Generate a random secret of at least 32 characters; configure the same value in PropertyRadar.
PROPERTYRADAR_WEBHOOK_SECRET=

# BatchData credentials are server-side only. Never expose these through NEXT_PUBLIC_*.
BATCHDATA_API_URL=https://api.batchdata.com
BATCHDATA_API_TOKEN=
# Use sandbox only with a sandbox token; the normal product workflow records mock data.
BATCHDATA_API_MODE=live
# Use at least 32 random characters and configure the same webhook secret in BatchData.
BATCHDATA_WEBHOOK_SECRET=
# Optional; defaults to storage/integrations/batchdata relative to the API process.
BATCHDATA_STORAGE_ROOT=storage/integrations/batchdata
